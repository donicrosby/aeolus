	(text "Ideal Diode\nMax output is 1.5A \nESP shouldn't draw more than 500mA"
		(exclude_from_sim no)
		(at 188.214 77.216 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6e753bb1-8a07-4716-b980-0ea2a80df9d9")
	)
	(text "Qwiic compatible conntectors to allow for\nfan controller modification or upgrades"
		(exclude_from_sim no)
		(at 353.06 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "839ff4b5-49be-42a2-bdb0-ffaac85915c6")
	)
	(text "The fan controller has only one PWM output\nbut a bank of 9 120mm fans could draw up to 4A\nin order to not melt the wires and reduce voltage drop\nthe header has been split into 3 to allow for reduced\ncurrents running through the fan wires\nUsing the buffers to distribute the PWM signal prevents signal\ndegridation and ensures clean signals to reach each bank of fans"
		(exclude_from_sim no)
		(at 188.468 211.074 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8766af50-2372-4a00-a256-6e9f75414658")
	)
	(text "Fan Power Monitoring\nShunt 7m Ohm\nLSB is 152.59uA\nAddress can be configured to 0x40, 0x41, 0x43, 0x44 "
		(exclude_from_sim no)
		(at 14.478 148.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
